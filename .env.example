# Django Ninja origin used by the same-origin Next.js proxy (/api/backend/*).
# Use the deployed API by default; override only when running Django locally.
BACKEND_API_ORIGIN=https://ceda-django-api.vercel.app

# Server-side fallback for API calls made during server rendering.
# Browser calls always use /api/backend so the session cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=/api/backend
